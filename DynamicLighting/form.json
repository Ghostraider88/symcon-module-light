                     {
                         "type":  "ExpansionPanel",
                         "caption": "Scene integration",
                         "items":  [ {"type":"Label","caption":"Automatic mode controls lights by lux and time. Any boolean trigger can load a scene. Priority holds it while true; optional ambient-demand gating delays activation until the lux/time automation would switch lights on. Resume can return to automatic mode when the trigger turns off."},
                                       {
                                           "type":  "SelectInstance",
                                           "name":  "SceneControlID",
                                           "value": 0,
                                           "validModules": ["{87F46796-CC43-442D-94FD-AAA0BD8D9F54}"],
                                           "caption": "Optional Scene Control instance"
                                       },
                                       {
                                           "type": "Button",
                                           "caption": "Load scenes from selected instance",
                                           "onClick": "DLT_SelectSceneControl($id, $SceneControlID);"
                                       },
                                       {
                                           "type": "Button",
                                           "name": "ResetSceneControlSelection",
                                           "caption": "Clear unavailable Scene Control selection",
                                           "visible": false,
                                           "onClick": "DLT_SelectSceneControl($id, 0);"
